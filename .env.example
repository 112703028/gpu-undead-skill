# 複製成 .env 後填入實際值。.env 已被 .gitignore 排除,不會被上傳。
AI_STACK_URL=https://<主機IP>:<埠>/ai-stack/root
AI_STACK_PROJECT=<專案名稱>
AI_STACK_USER=<你的帳號>
AI_STACK_PASS=<你的密碼>

# 以下皆為選填,括號內是預設值
# AI_STACK_CONTAINER_NAME=work1      # 容器名稱(只能小寫英文與數字)
# AI_STACK_GPU_MODEL=7960-RTX3090    # 或 4124-RTX3090
# AI_STACK_CUDA=12.4
# AI_STACK_GPU_COUNT=1
# AI_STACK_IMAGE=25.10-py3           # 公用鏡像的版本字串
# AI_STACK_SSH_PASS=                 # 容器 SSH 密碼,沒填就用登入密碼
# AI_STACK_BROWSER=msedge            # 或 chrome
